# For local development use npm run db:env instead of inventing keys.
# For an authorized deployment copy public URL/key from your own project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact deployment origin; loopback HTTP is allowed for local development.
AUTH_TRUSTED_ORIGIN=http://127.0.0.1:3000
# Keep false for the private pilot. Local db:env explicitly enables test signup.
# Public signup requires verified email delivery and approved operating conditions.
AUTH_ALLOW_SIGNUP=false
# Administrative import/local isolated tests only. Never NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
