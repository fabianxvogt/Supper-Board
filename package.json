{
  "name": "supper-board-nutrition",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.2 <23" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src scripts tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/db/**' --exclude 'tests/e2e/**'",
    "test:db": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/db",
    "test:e2e": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "db:env": "tsx scripts/local-env.ts",
    "verify:restore": "node --env-file=.env.local --import tsx scripts/verify-restore.ts",
    "import:bls": "node --env-file-if-exists=.env.local --import tsx scripts/import-bls/index.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "exceljs": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
